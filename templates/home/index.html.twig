{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}

	<nav class="navbar navbar-expand-lg bg-body-tertiary">
		<div class="container-fluid">
			<a class="navbar-brand" href="#">Navbar</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarSupportedContent">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					<li class="nav-item">
						<a class="nav-link active" aria-current="page" href="#">Home</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="#">Link</a>
					</li>
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							Dropdown
						</a>
						<ul class="dropdown-menu">
							<li>
								<a class="dropdown-item" href="#">Action</a>
							</li>
							<li>
								<a class="dropdown-item" href="#">Another action</a>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item" href="#">Something else here</a>
							</li>
						</ul>
					</li>
					<li class="nav-item">
						<a class="nav-link disabled" aria-disabled="true">Disabled</a>
					</li>
				</ul>
				<form class="d-flex" role="search">
					<input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
					<button class="btn btn-outline-success" type="submit">Search</button>
				</form>
			</div>
		</div>
	</nav>
	<h2>Catégorie test</h2>
	<ul>
		{% for subCategory in subCategories %}

			<li>
				<a href="{{path('subCategory_show', {subCategory : subCategory.id})}}">{{subCategory.name}}</a>
			</li>
		{% endfor %}
	</ul>


	<div
		id="carousel-container" class="relative w-full overflow-hidden">
		<!-- Carousel wrapper -->
		<div
			id="carousel-wrapper" class="flex duration-700 ease-in-out">
			<!-- Item 1 -->
			<div class="flex-shrink-0 w-1/4">
				<img src="https://picsum.photos/200/300" class="w-full h-full object-cover" alt="...">
				<h1 class="z-10">test</h1>
			</div>
			<!-- Item 2 -->
			<div class="flex-shrink-0 w-1/4">
				<img src="https://picsum.photos/200/300" class="w-full h-full object-cover" alt="...">
			</div>
			<!-- Item 3 -->
			<div class="flex-shrink-0 w-1/4">
				<img src="https://picsum.photos/200/300" class="w-full h-full object-cover" alt="...">
			</div>
			<!-- Item 4 -->
			<div class="flex-shrink-0 w-1/4">
				<img src="https://picsum.photos/200/300" class="w-full h-full object-cover" alt="...">
			</div>
			<!-- Item 5 -->
			<div class="flex-shrink-0 w-1/4">
				<img src="https://picsum.photos/200/300" class="w-full h-full object-cover" alt="...">
			</div>
		</div>

		<!-- Controls -->
		<button id="prev-btn" class="absolute top-1/2 left-0 transform -translate-y-1/2 bg-gray-800 text-white p-2">
			←
		</button>
		<button id="next-btn" class="absolute top-1/2 right-0 transform -translate-y-1/2 bg-gray-800 text-white p-2">
			→
		</button>
	</div>

	<script>
		const carouselWrapper = document.getElementById('carousel-wrapper');
const nextBtn = document.getElementById('next-btn');
const prevBtn = document.getElementById('prev-btn');

let currentOffset = 0;
const itemWidth = carouselWrapper.children[0].offsetWidth;

nextBtn.addEventListener('click', () => { // Move to the next image
currentOffset -= itemWidth;
if (Math.abs(currentOffset) >= carouselWrapper.scrollWidth) {
currentOffset = 0; // Reset to the first image if we've reached the end
}carouselWrapper.style.transform = `translateX(${currentOffset}px)`;
});

prevBtn.addEventListener('click', () => { // Move to the previous image
currentOffset += itemWidth;
if (currentOffset > 0) {
currentOffset = -(carouselWrapper.scrollWidth - itemWidth); // Go back to the last image
}carouselWrapper.style.transform = `translateX(${currentOffset}px)`;
});
	</script>


{% endblock %}
