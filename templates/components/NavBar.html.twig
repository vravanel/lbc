<div class="container-fluid py-2">
	<ul class="nav justify-content-center align-items-center">
		{% for categoryData in this.categoriesWithSubCategories %}
			<li class="nav-item position-relative">
				<a href="#" class="nav-link text-dark px-3 d-flex justify-content-center align-items-center" style="position: relative;">
					{{ categoryData.category.name }}
					<span class="point"></span>
				</a>
				<div class="dropdown-menu-container">
					<div class="dropdown-menu row shadow-lg border-0">
						<div class="col-4 bg-light p-3 fw-bold">{{ categoryData.category.name }}</div>
						<div class="col-8 p-3 bg-white">
							{% for subCategory in categoryData.subCategories %}
								<a href="#" class="dropdown-item">{{ subCategory.name }}</a>
							{% endfor %}
						</div>
					</div>
				</div>
			</li>
		{% endfor %}
	</ul>
</div>
