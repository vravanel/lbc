<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Document</title>
		<link rel="stylesheet" href="{{ asset('assets/styles/login/global.scss') }}">
	</head>
	<body>
		<header class="header_login">
			<div class="header_login_div">
				<a href="#" class="header_login_div_link">{{ ux_icon('flowbite:arrow-left-outline') }}</a>
				<img class="header_login_div_img" src="{{ asset('assets/images/leboncoin.png') }}" alt="Logo LeBonCoin">
			</div>
		</header>
		<main class="main_login">
			<form method="post" class="w-4/12  mx-auto">
				<div class="card">
					{% if error %}
						<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
					{% endif %}

					{% if app.user %}
						<div class="mb-3">
							You are logged in as
							{{ app.user.userIdentifier }},
							<a href="{{ path('app_logout') }}">Logout</a>
						</div>
					{% endif %}

					<h1 class="card-title">Bonjour !</h1>
					<p class="card-text">Connectez-vous pour découvrir toutes nos fonctionnalités.</p>
					<div class="">
						<label for="username" class="card-form-label">Email *</label>
						<input type="email" value="{{ last_username }}" name="_username" id="username" class="card-form-control" autocomplete="email" required autofocus>
					</div>
					<div class="">
						<label for="password" class="card-form-label">Mot de passe *</label>
						<input type="password" id="password" class="card-form-control" autocomplete="current-password" required>
					</div>
					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<button class="card-button" type="submit">
						Se connecter
					</button>
					<div class="card-register-section">
						<p>Envie de nous rejoindre ?</p>
						<a href="/register">Créer un compte</a>
					</div>
				</div>
			</form>
		</main>
	</body>
</html>
